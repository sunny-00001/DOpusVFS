#include "resource.h"
#include "windows.h"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x4L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "ProcessVFS"
            VALUE "FileDescription", "Process VFS Plugin for Directory Opus"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "ProcessVFS"
            VALUE "LegalCopyright", "(c) 2026"
            VALUE "OriginalFilename", "ProcessVFS.dll"
            VALUE "ProductName", "Process VFS Plugin"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

IDD_PROCESS_CONFIG DIALOGEX 0, 0, 300, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Process VFS"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 138, 234, 50, 12
    PUSHBUTTON      "Cancel", IDCANCEL, 192, 234, 50, 12
    PUSHBUTTON      "Apply", IDC_APPLY, 246, 234, 50, 12

    LISTBOX         IDC_NAV_LIST, 4, 4, 36, 228, LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_LBL_DEFAULT_ACTION, 44, 4, 80, 8
    COMBOBOX        IDC_DEFAULT_ACTION, 44, 12, 82, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "", IDC_SHOW_SYSTEM_PROCESSES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 26, 200, 10

    LTEXT           "", IDC_LBL_COLUMNS, 44, 4, 80, 8
    CONTROL         "", IDC_COL_PID, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 16, 120, 10
    CONTROL         "", IDC_COL_STATUS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 28, 120, 10
    CONTROL         "", IDC_COL_CPU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 40, 120, 10
    CONTROL         "", IDC_COL_MEMORY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 52, 120, 10
    CONTROL         "", IDC_COL_THREADS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 64, 120, 10
    CONTROL         "", IDC_COL_PATH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 76, 120, 10
    CONTROL         "", IDC_COL_CREATETIME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 88, 120, 10
    CONTROL         "", IDC_COL_SESSIONID, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 100, 120, 10
    CONTROL         "", IDC_COL_DESCRIPTION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 112, 120, 10
    CONTROL         "", IDC_COL_DISK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 16, 120, 10
    CONTROL         "", IDC_COL_HANDLES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 28, 120, 10
    CONTROL         "", IDC_COL_USER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 40, 120, 10
    CONTROL         "", IDC_COL_PRIORITY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 52, 120, 10
    CONTROL         "", IDC_COL_NETWORK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 64, 120, 10
    CONTROL         "", IDC_COL_PARENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 76, 120, 10
    CONTROL         "", IDC_COL_CMDLINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 88, 120, 10
    CONTROL         "", IDC_COL_ARCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 172, 100, 120, 10

    LTEXT           "", IDC_LBL_KILL_METHOD, 44, 4, 80, 8
    COMBOBOX        IDC_KILL_METHOD, 44, 12, 82, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "", IDC_CHK_CONFIRM_KILL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 26, 200, 10
    CONTROL         "", IDC_CHK_CONFIRM_TREE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 38, 200, 10
    CONTROL         "", IDC_CHK_AUTO_REFRESH_KILL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 50, 200, 10
    CONTROL         "", IDC_CHK_WARN_CRITICAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 62, 200, 10

    LTEXT           "", IDC_LBL_CACHE_TIMEOUT, 44, 4, 80, 8
    EDITTEXT        IDC_CACHE_TIMEOUT, 44, 12, 80, 10, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "", IDC_LBL_LOG_PATH, 44, 28, 80, 8
    EDITTEXT        IDC_LOG_PATH, 44, 36, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_LOG_PATH, 248, 36, 20, 10

    LTEXT           "", IDC_LBL_CONFIG_PATH, 44, 52, 80, 8
    EDITTEXT        IDC_CONFIG_PATH, 44, 60, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_CONFIG_PATH, 248, 60, 20, 10

    PUSHBUTTON      "TaskMgr", IDC_OPEN_TASKMGR, 4, 234, 54, 12
    PUSHBUTTON      "Reset", IDC_RESET_DEFAULTS, 62, 234, 50, 12
END
