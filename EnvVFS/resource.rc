#include "resource.h"
#include "windows.h"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x4L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "EnvVFS"
            VALUE "FileDescription", "Windows Environment Variable VFS Plugin for Directory Opus"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "EnvVFS"
            VALUE "LegalCopyright", "(c) 2026"
            VALUE "OriginalFilename", "EnvVFS.dll"
            VALUE "ProductName", "EnvVFS Plugin"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_ENV_CONFIG DIALOGEX 0, 0, 380, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Environment Variable VFS Configuration"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 215, 259, 75, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 298, 259, 75, 14

    LTEXT           "", IDC_MENU_BUTTON, 356, 7, 20, 14, SS_NOTIFY | SS_CENTERIMAGE

    LISTBOX         IDC_NAV_LIST, 7, 7, 48, 245, LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP

    CONTROL         "", IDC_SHOW_SYS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 9, 200, 8
    CONTROL         "", IDC_SHOW_USER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 21, 200, 8
    CONTROL         "", IDC_SHOW_VOLATILE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 33, 200, 8
    LTEXT           "", IDC_LBL_REFRESH, 63, 45, 100, 8
    EDITTEXT        IDC_REFRESH_INTERVAL, 63, 55, 80, 10, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "", IDC_LBL_COLUMNS, 63, 9, 80, 8
    CONTROL         "", IDC_COL_NAME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 21, 80, 8
    CONTROL         "", IDC_COL_VALUE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 33, 80, 8
    CONTROL         "", IDC_COL_TYPE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 45, 80, 8
    CONTROL         "", IDC_COL_SOURCE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 57, 80, 8
    LTEXT           "", IDC_LBL_FONT_SIZE, 63, 69, 80, 8
    COMBOBOX        IDC_FONT_SIZE, 63, 79, 80, 100, CBS_DROPDOWNLIST | WS_TABSTOP

    LTEXT           "", IDC_LBL_DEF_EDITOR, 63, 9, 80, 8
    EDITTEXT        IDC_DEF_EDITOR, 63, 19, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_EDITOR, 268, 19, 30, 10
    CONTROL         "", IDC_CHK_CONFIRM_DEL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 35, 100, 8
    CONTROL         "", IDC_CHK_AUTO_BACKUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 47, 100, 8
    LTEXT           "", IDC_LBL_BACKUP_PATH, 63, 59, 80, 8
    EDITTEXT        IDC_BACKUP_PATH, 63, 69, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_BACKUP, 268, 69, 30, 10

    LTEXT           "", IDC_LBL_CACHE_TMOUT, 63, 9, 80, 8
    EDITTEXT        IDC_CACHE_TMOUT, 63, 19, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_CHK_VERBOSE_LOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 35, 100, 8
    CONTROL         "", IDC_CHK_ENABLE_TRAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 47, 100, 8
    LTEXT           "", IDC_LBL_LOG_PATH, 63, 59, 80, 8
    EDITTEXT        IDC_LOG_PATH, 63, 69, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_LOG, 268, 69, 30, 10

    PUSHBUTTON      "Open System Settings", IDC_OPEN_ENV, 7, 259, 95, 14
    PUSHBUTTON      "Reset Defaults", IDC_RESET_DEFAULTS, 107, 259, 60, 14
END
