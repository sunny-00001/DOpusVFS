    LTEXT           "", IDC_LBL_LOG_MAX_FILES, 63, 93, 80, 8
    EDITTEXT        IDC_LOG_MAX_FILES, 63, 103, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "打开", IDC_OPEN_LOG, 63, 117, 50, 10
    PUSHBUTTON      "清除", IDC_CLEAR_LOG, 118, 117, 50, 10

    CONTROL         "", IDC_VERBOSE_LOGGING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 9, 150, 8
    CONTROL         "", IDC_CONFIRM_DELETE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 21, 150, 8
    CONTROL         "", IDC_SHOW_HIDDEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 33, 150, 8
