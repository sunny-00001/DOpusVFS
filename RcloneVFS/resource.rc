    LTEXT           "", IDC_LBL_CACHE_DIR, 63, 165, 80, 8
    EDITTEXT        IDC_CACHE_DIR, 63, 175, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_CACHE_DIR, 268, 175, 30, 10

    LTEXT           "", IDC_LBL_MAX_CONN, 63, 9, 80, 8
    EDITTEXT        IDC_MAX_CONNECTIONS, 63, 19, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_TRANSFERS, 63, 33, 80, 8
    EDITTEXT        IDC_TRANSFERS, 63, 43, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
