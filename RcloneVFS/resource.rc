    EDITTEXT        IDC_READ_CHUNK_SIZE, 63, 139, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_READ_AHEAD, 63, 153, 80, 8
