    EDITTEXT        IDC_CHECKERS, 63, 67, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_BANDWIDTH, 63, 81, 80, 8
    EDITTEXT        IDC_BANDWIDTH_LIMIT, 63, 91, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_BUFFER_SIZE, 63, 105, 80, 8
