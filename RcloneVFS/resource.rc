﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿#include "resource.h"
#include "windows.h"

IDI_RCLONE        ICON "rclone.ico"
IDI_RCLONE_SMALL  ICON "rclone.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x4L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RcloneVFS"
            VALUE "FileDescription", "Rclone VFS Plugin for Directory Opus"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "RcloneVFS"
            VALUE "LegalCopyright", "(c) 2026"
            VALUE "OriginalFilename", "RcloneVFS.dll"
            VALUE "ProductName", "Rclone VFS Plugin"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_RCLONE_CONFIG DIALOGEX 0, 0, 380, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rclone VFS"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "确定", IDOK, 215, 259, 75, 14
    PUSHBUTTON      "取消", IDCANCEL, 298, 259, 75, 14

    LISTBOX         IDC_NAV_LIST, 7, 7, 48, 245, LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_LBL_RCLONE_PATH, 63, 9, 100, 8
    EDITTEXT        IDC_RCLONE_PATH, 63, 19, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_RCLONE, 268, 19, 30, 10
    LTEXT           "", IDC_LBL_CONFIG_PATH, 63, 33, 100, 8
    EDITTEXT        IDC_CONFIG_PATH, 63, 43, 200, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_CONFIG, 268, 43, 30, 10
    CONTROL         "", IDC_AUTO_START_DAEMON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 57, 150, 8

    LTEXT           "", IDC_LBL_RC_PORT, 63, 9, 80, 8
