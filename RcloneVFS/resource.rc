    CONTROL         "", IDC_NO_CHECKSUM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 69, 150, 8
    CONTROL         "", IDC_FAST_LIST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 81, 150, 8
    CONTROL         "", IDC_USE_MMAP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 93, 150, 8
    CONTROL         "", IDC_USE_RCLONE_COPY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 105, 150, 8

    PUSHBUTTON      "配置", IDC_OPEN_CONFIG, 7, 259, 50, 14
    PUSHBUTTON      "重置", IDC_RESET_DEFAULTS, 62, 259, 50, 14
