    LTEXT           "", IDC_LBL_WRITE_BACK_DELAY, 63, 45, 80, 8
    EDITTEXT        IDC_WRITE_BACK_DELAY, 63, 55, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_MAX_IDLE, 63, 69, 80, 8
    EDITTEXT        IDC_MAX_IDLE, 63, 79, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_LBL_STATS_INTERVAL, 63, 93, 80, 8
    EDITTEXT        IDC_STATS_INTERVAL, 63, 103, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_CACHE_WRITE_BACK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 117, 150, 8

    CONTROL         "", IDC_LOG_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 63, 9, 150, 8
