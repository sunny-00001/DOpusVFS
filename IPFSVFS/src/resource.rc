#include "windows.h"
#include "resource.h"

1 VERSIONINFO
FILEVERSION 1,0,0,0
BEGIN
END

IDD_IPFS_CONFIG DIALOGEX 0, 0, 280, 180
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IPFS VFS 配置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX        "守护进程设置", IDC_STATIC, 10, 10, 260, 100
    LTEXT           "IPFS 守护进程地址:", IDC_LBL_DAEMON_HOST, 20, 30, 120, 14
    EDITTEXT        IDC_DAEMON_HOST, 150, 28, 110, 14, ES_AUTOHSCROLL
    LTEXT           "IPFS 守护进程端口:", IDC_LBL_DAEMON_PORT, 20, 55, 120, 14
    EDITTEXT        IDC_DAEMON_PORT, 150, 53, 60, 14, ES_NUMBER
    AUTOCHECKBOX    "自动连接守护进程", IDC_CHK_AUTO_CONNECT, 20, 80, 140, 14
    PUSHBUTTON      "测试连接", IDC_BTN_TEST, 170, 78, 90, 20
    DEFPUSHBUTTON   "确定", IDOK, 120, 130, 70, 24
    PUSHBUTTON      "取消", IDCANCEL, 200, 130, 70, 24
END
