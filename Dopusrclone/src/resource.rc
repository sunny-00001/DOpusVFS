#include "resource.h"
#include "windows.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

IDD_RCLONE_CONFIG DIALOGEX 0, 0, 320, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rclone VFS"
FONT 9, "Microsoft YaHei UI"
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 208, 244, 50, 12
    PUSHBUTTON      "Cancel", IDCANCEL, 262, 244, 50, 12
    PUSHBUTTON      "Apply", IDC_RCLONE_APPLY, 154, 244, 50, 12
    LISTBOX         IDC_RCLONE_NAV_LIST, 4, 4, 36, 236, LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_RCLONE_LBL_EXE, 44, 8, 80, 8
    EDITTEXT        IDC_RCLONE_EXE_PATH, 44, 16, 180, 10, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_RCLONE_BROWSE_EXE, 230, 16, 26, 10
    LTEXT           "", IDC_RCLONE_LBL_REMOTE, 44, 32, 80, 8
    EDITTEXT        IDC_RCLONE_DEFAULT_REMOTE, 44, 40, 120, 10, ES_AUTOHSCROLL
    LTEXT           "", IDC_RCLONE_LBL_CACHE, 44, 8, 80, 8
    EDITTEXT        IDC_RCLONE_CACHE_TIMEOUT, 44, 16, 60, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_RCLONE_LBL_UPLOAD, 44, 30, 80, 8
    EDITTEXT        IDC_RCLONE_UPLOAD_CHUNK, 44, 38, 60, 10, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "", IDC_RCLONE_LBL_DL_BUF, 44, 52, 80, 8
    EDITTEXT        IDC_RCLONE_DL_BUFFER, 44, 60, 60, 10, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_RCLONE_CHK_HIDDEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 74, 180, 10
    CONTROL         "", IDC_RCLONE_CHK_DEL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 86, 180, 10
    CONTROL         "", IDC_RCLONE_CHK_OVERWRITE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 98, 180, 10
    CONTROL         "", IDC_RCLONE_CHK_VERBOSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 110, 180, 10
    PUSHBUTTON      "Reset", IDC_RCLONE_RESET, 4, 244, 50, 12
END

IDD_RCLONE_ABOUT DIALOGEX 0, 0, 300, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Rclone VFS"
FONT 9, "Microsoft YaHei UI"
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 125, 159, 50, 14
    LTEXT           "Rclone VFS", IDC_STATIC, 60, 20, 200, 16
    LTEXT           "Version 1.0.0", IDC_STATIC, 60, 40, 200, 12
    LTEXT           "Cloud Storage VFS (Rclone)", IDC_STATIC, 60, 55, 200, 12
    LTEXT           "For Directory Opus", IDC_STATIC, 60, 70, 200, 12
    GROUPBOX        "Features", IDC_STATIC, 7, 90, 286, 60
    LTEXT           "- Browse remote storage via Rclone", IDC_STATIC, 15, 105, 270, 12
    LTEXT           "- Upload/download/manage cloud files", IDC_STATIC, 15, 120, 270, 12
    LTEXT           "- Support major cloud storage services", IDC_STATIC, 15, 135, 270, 12
END