#include "windows.h"
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

1 VERSIONINFO
FILEVERSION 1,0,0,0
BEGIN
END

IDD_WIFI_CONFIG DIALOGEX 0, 0, 300, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WiFi VFS"
FONT 9, "Microsoft YaHei UI"
BEGIN
    DEFPUSHBUTTON   "确定", IDOK, 138, 234, 50, 12
    PUSHBUTTON      "取消", IDCANCEL, 192, 234, 50, 12
    PUSHBUTTON      "应用", IDC_WIFI_APPLY, 246, 234, 50, 12

    LISTBOX         IDC_WIFI_NAV_LIST, 4, 2, 48, 228, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP

    // Page 0: General
    GROUPBOX        "常规设置", IDC_GRP_GENERAL, 56, 2, 240, 70
    CONTROL         "", IDC_SHOW_PWD_DEFAULT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 14, 200, 10
    LTEXT           "", IDC_LBL_REFRESH, 64, 26, 80, 8
    EDITTEXT        IDC_REFRESH_INTERVAL, 64, 38, 80, 10, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_CHK_AUTO_CONNECT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 50, 200, 10
    CONTROL         "", IDC_CHK_ADMIN_WARN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 62, 200, 10

    // Page 1: Display columns
    GROUPBOX        "显示列", IDC_GRP_DISPLAY, 56, 2, 240, 70
    CONTROL         "", IDC_COL_PASSWORD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 14, 120, 10
    CONTROL         "", IDC_COL_AUTH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 26, 120, 10
    CONTROL         "", IDC_COL_CIPHER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 38, 120, 10
    CONTROL         "", IDC_COL_MODE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 50, 120, 10
    CONTROL         "", IDC_COL_TYPE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 62, 120, 10

    // Page 2: Network Scan
    GROUPBOX        "网络扫描", IDC_GRP_SCAN, 56, 2, 240, 200
    PUSHBUTTON      "扫描网络", IDC_SCAN_BUTTON, 64, 14, 50, 12
    LISTBOX         IDC_NETWORK_LIST, 64, 26, 224, 156, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "连接", IDC_CONNECT_BUTTON, 64, 186, 50, 12
    PUSHBUTTON      "刷新", IDC_REFRESH_SCAN, 120, 186, 50, 12
    LTEXT           "", IDC_SCAN_STATUS, 64, 198, 224, 10

    // Page 3: Advanced Settings
    GROUPBOX        "高级设置", IDC_GRP_ADV_SETTINGS, 56, 2, 240, 100
    LTEXT           "", IDC_LBL_AUTO_POLICY, 64, 14, 200, 8
    COMBOBOX        IDC_AUTO_CONNECT_POLICY, 64, 26, 200, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "", IDC_LBL_PASSWORD_POLICY, 64, 42, 200, 8
    COMBOBOX        IDC_PASSWORD_POLICY, 64, 54, 200, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "", IDC_LBL_SCAN_INTERVAL, 64, 70, 200, 8
    EDITTEXT        IDC_SCAN_INTERVAL, 64, 82, 80, 12, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "", IDC_PRIORITY_SORT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 64, 94, 200, 10

    PUSHBUTTON      "NetCfg", IDC_OPEN_NETCFG, 4, 234, 54, 12
    PUSHBUTTON      "Reset", IDC_WIFI_RESET, 62, 234, 50, 12
END

IDD_WIFI_ABOUT DIALOGEX 0, 0, 300, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 WiFi VFS"
FONT 9, "Microsoft YaHei UI"
BEGIN
    DEFPUSHBUTTON   "确定", IDOK, 125, 159, 50, 14
    ICON            IDI_APPLICATION, IDC_STATIC, 20, 20, 20, 20
    LTEXT           "WiFi 管理 VFS", IDC_STATIC, 60, 20, 200, 16
    LTEXT           "版本 1.0.0", IDC_STATIC, 60, 40, 200, 12
    LTEXT           "WiFi 网络虚拟文件系统", IDC_STATIC, 60, 55, 200, 12
    LTEXT           "用于 Directory Opus", IDC_STATIC, 60, 70, 200, 12
    GROUPBOX        "功能", IDC_STATIC, 7, 90, 286, 60
    LTEXT           "• 浏览已保存的 WiFi 网络", IDC_STATIC, 15, 105, 270, 12
    LTEXT           "• 查看 WiFi 密码和详细配置", IDC_STATIC, 15, 120, 270, 12
    LTEXT           "• 编辑 WiFi 密码 / 连接 / 忘记网络", IDC_STATIC, 15, 135, 270, 12
END

IDD_WIFI_EDIT DIALOGEX 0, 0, 280, 140
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑WiFi密码"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "WiFi名称:", IDC_STATIC, 14, 14, 60, 12
    LTEXT "", IDC_STATIC, 80, 14, 186, 12
    LTEXT "新密码:", IDC_STATIC, 14, 40, 60, 12
    EDITTEXT IDC_WIFI_PASSWORD, 80, 38, 186, 14, ES_AUTOHSCROLL | WS_BORDER
    CONTROL "显示密码", IDC_SHOW_PASSWORD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 80, 60, 80, 14
    DEFPUSHBUTTON "确定", IDOK, 120, 108, 70, 22
    PUSHBUTTON "取消", IDCANCEL, 198, 108, 70, 22
    LTEXT "提示: 修改密码后将更新WiFi配置文件", IDC_STATIC, 14, 84, 252, 12
END

IDD_WIFI_DETAILS DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WiFi详细信息"
FONT 9, "Microsoft YaHei UI"
BEGIN
    DEFPUSHBUTTON "确定", IDOK, 125, 179, 50, 14
    EDITTEXT IDC_DETAILS_TEXT, 7, 7, 306, 166, ES_MULTILINE | ES_READONLY | WS_VSCROLL
END
